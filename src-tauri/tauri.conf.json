{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "irislet",
	"version": "0.1.0",
	"identifier": "com.mingsiamz.irislet",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "irislet",
				"width": 1280,
				"height": 720,
				"resizable": true,
				"fullscreen": false,
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"fileAssociations": [
			{
				"ext": ["md", "markdown", "org"],
				"name": "Markdown / Org 文档",
				"description": "用 irislet 打开 Markdown / Org 文件",
				"role": "Viewer"
			}
		]
	},
	"plugins": {
		"cli": {
			"args": [
				{
					"short": "v",
					"name": "verbose",
					"description": "Verbosity level"
				}
			],
			"subcommands": {
				"run": {}
			}
		}
	}
}
