{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    { "identifier": "fs:allow-read-text-file",  "allow": [{ "path": "$APPDATA/**" }, { "path": "**/*.md" }, { "path": "**/*.markdown" }, { "path": "**/*.org" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-exists",          "allow": [{ "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-mkdir",           "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] }
  ]
}

